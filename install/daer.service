[Unit]
Description=daer transparent proxy daemon
Documentation=https://github.com/ming2k/daer
After=network-online.target
Wants=network-online.target
# Bound crash loops: give up after 5 restarts within 5 minutes.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root

# Resource limits
LimitNPROC=4096
LimitNOFILE=1048576
LimitMEMLOCK=infinity

# OOM score adjustment: -1000 (never kill) to 1000 (always kill first)
# -100 means daer is less likely to be killed than normal processes
OOMScoreAdjust=-100

# Validate configuration before starting. A broken configuration exits with non-zero
# and prevents starting or restarting with an invalid state.
ExecStartPre=/usr/bin/daer config validate -c /etc/daer/config.toml
ExecStart=/usr/bin/daer run -c /etc/daer/config.toml --object /usr/lib/daer/datapath.o
ExecReload=/usr/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5s

# Timeout configuration
TimeoutStartSec=120
TimeoutStopSec=30

# Capability bounding and ambient capabilities:
# - CAP_BPF & CAP_NET_ADMIN for loading and attaching the eBPF datapath and tproxy
# - CAP_NET_BIND_SERVICE for binding to privileged ports (< 1024, such as DNS port 53)
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_NET_BIND_SERVICE

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Configuration directory and write access for subscription persistence (persist.d)
ConfigurationDirectory=daer
ReadWritePaths=/etc/daer

[Install]
WantedBy=multi-user.target
