[Unit]
Description=daer transparent proxy daemon
Documentation=https://github.com/ming2k/daer
After=network-online.target
Wants=network-online.target
# Bound crash loops: give up after 5 restarts within 5 minutes.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root

# Resource limits
LimitNPROC=4096
LimitNOFILE=1048576
LimitMEMLOCK=infinity

# OOM score adjustment: -1000 (never kill) to 1000 (always kill first)
# -100 means daer is less likely to be killed than normal processes
OOMScoreAdjust=-100

# Validate configuration before starting. A broken configuration exits with non-zero
# and prevents starting or restarting with an invalid state. `daer check` is the one
# pre-bind gate: it resolves subscriptions and rule providers, compiles every rule and
# builds every group, so a configuration that would fail at runtime fails here instead.
ExecStartPre=/usr/bin/daer check -c /etc/daer/config.toml
ExecStart=/usr/bin/daer run -c /etc/daer/config.toml --object /usr/lib/daer/datapath.o
ExecReload=/usr/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5s

# Timeout configuration
TimeoutStartSec=120
TimeoutStopSec=30

# Capability bounding and ambient capabilities:
# - CAP_BPF & CAP_NET_ADMIN for loading and attaching the eBPF datapath and tproxy
# - CAP_PERFMON for the verifier's allow_ptr_leaks: the fast parser advances a
#   packet pointer by the IPv4 IHL and IPv6 extension-header lengths, which this
#   kernel only permits for a process holding CAP_PERFMON (or full root)
# - CAP_SYS_ADMIN creates the private ingress network namespace (`daer0ns`), moves
#   `daer0peer` into it, enters it to bind the transparent listeners and attach the
#   peer program, and removes it on shutdown
# - CAP_NET_BIND_SERVICE for binding to privileged ports (< 1024, such as DNS port 53)
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_ADMIN CAP_NET_BIND_SERVICE

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
# ProtectKernelTunables must remain false: daer tunes sysctls on the host end
# (daer0) and, through daer0ns, on the peer, and pins eBPF maps to /sys/fs/bpf.
ProtectKernelTunables=false
LockPersonality=true
RestrictRealtime=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Configuration directory, BPF filesystem, and write access for subscription persistence.
# `/run/netns` is the mount point `ip netns add` uses for the private ingress namespace; it
# must exist and be writable for CAP_SYS_ADMIN to bind the namespace mount.
ConfigurationDirectory=daer
RuntimeDirectory=netns
ReadWritePaths=/etc/daer /sys/fs/bpf /run/netns

# Where downloaded rule sets are cached (ADR-0014). The default is `$XDG_CACHE_HOME` or
# `$HOME/.cache`, and `ProtectHome=true` above makes that unwritable — the fallback write is
# best-effort, so the failure is silent and only shows up as a provider that cannot survive
# the network going away. `CacheDirectory=daer` creates /var/cache/daer and grants write
# access to exactly it, and the variable points the loader there.
CacheDirectory=daer
Environment=DAER_RULE_CACHE_DIR=/var/cache/daer/rules

[Install]
WantedBy=multi-user.target
