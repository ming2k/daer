# Rust build artifacts
/target
**/*.rs.bk
*.o
*.d
crates/daer-ebpf/ebpf-out/

# eBPF build artifacts and generated headers
/ebpf/headers

# Python bytecode cache
__pycache__/
*.py[cod]
*$py.class

# Test / debug logs and check artifacts
daer-kernel-check/
*.log

# Site-specific daer configurations (may contain credentials or node links).
# Keep the tracked reference example; everything else with this root-level
# `daer.<site>.toml` shape is operator data and must not be committed.
/daer.*.toml
!/daer.example.toml

# Editor and environment
*~
*.swp
*.swo
.vscode/
.idea/
.DS_Store
.cargo/config.local.toml
