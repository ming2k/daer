{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "disable-waiting-network": {
      "type": "boolean",
      "default": false
    },
    "dns": {
      "$ref": "#/$defs/Dns",
      "default": {
        "fake-ip": {
          "enabled": false,
          "exclude": [],
          "inet": "198.18.0.0/15",
          "pool-size": 65535
        },
        "ipversion-prefer": "any",
        "max-cache-size": 65536,
        "optimistic-cache": true,
        "optimistic-cache-ttl": "1m",
        "optimistic-stale-reply-ttl": "30s",
        "request": {
          "rules": []
        },
        "response": {
          "rules": []
        },
        "upstream": []
      }
    },
    "election": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Election"
      }
    },
    "group": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Group"
      }
    },
    "include": {
      "description": "Globs, relative to the directory of the file that names them.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lan-interface": {
      "description": "Ingress interfaces receiving client traffic.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "log-level": {
      "description": "`tracing` filter directive, e.g. `info`, `debug`, or `daer=debug,netune=trace`.",
      "type": "string",
      "default": "info"
    },
    "node": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "routing": {
      "$ref": "#/$defs/Routing",
      "default": {
        "default": "direct"
      }
    },
    "rule-set": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleProvider"
      }
    },
    "schema": {
      "description": "Schema version. Bumped when a change cannot be expressed as a default.",
      "type": "integer",
      "format": "uint32",
      "default": 6,
      "minimum": 0
    },
    "subscription": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Subscription"
      }
    },
    "tls": {
      "description": "Defaults for every outbound TLS leg, with per-node overrides.",
      "$ref": "#/$defs/Tls",
      "default": {
        "fragment": false,
        "fragment-interval": "10-20",
        "fragment-length": "50-100"
      }
    },
    "wan-interface": {
      "description": "Egress interfaces: `\"auto\"` or an explicit list.",
      "$ref": "#/$defs/WanInterface",
      "default": "auto"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AutoKeyword": {
      "description": "The only bare string `wan-interface` accepts.",
      "oneOf": [
        {
          "description": "Follow the interface carrying the default route.",
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "Dns": {
      "type": "object",
      "properties": {
        "bind": {
          "type": [
            "string",
            "null"
          ]
        },
        "fake-ip": {
          "$ref": "#/$defs/FakeIpConfig",
          "default": {
            "enabled": false,
            "exclude": [],
            "inet": "198.18.0.0/15",
            "pool-size": 65535
          }
        },
        "fixed-domain-ttl": {
          "description": "`[dns.fixed-domain-ttl]` — domain suffix to fixed TTL duration.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ipversion-prefer": {
          "description": "Preferred IP family for DNS answers (`\"any\"`, `\"ipv4\"`, or `\"ipv6\"`).",
          "$ref": "#/$defs/IpVersionPrefer",
          "default": "any"
        },
        "max-cache-size": {
          "type": "integer",
          "format": "int32",
          "default": 65536
        },
        "optimistic-cache": {
          "type": "boolean",
          "default": true
        },
        "optimistic-cache-ttl": {
          "type": "string",
          "default": "1m"
        },
        "optimistic-stale-reply-ttl": {
          "type": "string",
          "default": "30s"
        },
        "request": {
          "$ref": "#/$defs/DnsRouting",
          "default": {
            "rules": []
          }
        },
        "response": {
          "$ref": "#/$defs/DnsRouting",
          "default": {
            "rules": []
          }
        },
        "upstream": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DnsRouting": {
      "description": "`[dns.request]` / `[dns.response]`.",
      "type": "object",
      "properties": {
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Election": {
      "description": "One `[[election]]` entry: the routing target and the rule that elects one node.\n\nThe input is exactly one of `group` or `node`. A group is a set of candidates; a\nnode is a singleton candidate set. The output is always one node (or no node when\nthe input has no usable candidate).",
      "type": "object",
      "properties": {
        "group": {
          "description": "The candidate set. Mutually exclusive with `node`.",
          "type": [
            "string",
            "null"
          ]
        },
        "interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "description": "The probe this election asks the health scheduler to run. Absent fields use\n[`ProbeSettings::default`]; there is no global defaults table.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProbeMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "node": {
          "description": "A singleton candidate set. Mutually exclusive with `group`.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "type": [
            "string",
            "null"
          ]
        },
        "tolerance": {
          "description": "The moving-average switch threshold. Selection policy, not probe state.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "The selection rule.",
          "$ref": "#/$defs/ElectionKind"
        },
        "udp-dns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "ElectionKind": {
      "description": "How an election selects one node from its input.",
      "oneOf": [
        {
          "description": "The input must be a node; the election returns that node or fails when it is\nnot usable.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "Pick a random alive node.",
          "type": "string",
          "const": "random"
        },
        {
          "description": "Pick the node with the lowest last measured latency.",
          "type": "string",
          "const": "min"
        },
        {
          "description": "Pick the node with the lowest average of its last 10 latencies.",
          "type": "string",
          "const": "min-avg10"
        },
        {
          "description": "Pick the node with the lowest exponentially weighted moving average.",
          "type": "string",
          "const": "min-moving-avg"
        }
      ]
    },
    "FakeIpConfig": {
      "description": "`[dns.fake-ip]` — synthetic IP pool configuration (ADR-0012).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "exclude": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "inet": {
          "type": "string",
          "default": "198.18.0.0/15"
        },
        "inet6": {
          "description": "The optional IPv6 pool.\n\n`None` keeps the historic IPv4-only Fake-IP behaviour: `A` is synthesised and `AAAA`\nis answered with an empty NOERROR so a dual-stack client falls back to the synthetic\naddress. Setting a prefix enables IPv6 synthesis as well. The key is explicit rather\nthan a second meaning for `inet`, because one prefix cannot describe both families.",
          "type": [
            "string",
            "null"
          ]
        },
        "pool-size": {
          "type": "integer",
          "format": "uint",
          "default": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Filter": {
      "description": "A `group.filters` entry: an expression, or an expression plus values the\nselected node inherits.",
      "anyOf": [
        {
          "description": "`sub(sub) && !name(keyword: 'ExpireAt:')`",
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "annotate": {
              "description": "Values copied into the selected node's properties.",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "match": {
              "description": "The predicate conjunction.",
              "type": "string"
            }
          },
          "required": [
            "match"
          ]
        }
      ]
    },
    "Flow": {
      "description": "How a protocol's payload is framed (ADR-0028).\n\nVision is a VLESS flow, not a REALITY feature: the reference applies it from\n`flow`, and a node whose user is configured for it **rejects** a client that omits\nit, so this is not a tuning knob.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "xtls-rprx-vision"
          ]
        },
        {
          "description": "Vision with UDP/443 allowed through the tunnel. The reference refuses UDP/443\nunder plain Vision because a QUIC flow inside XTLS double-encrypts; this is the\nopt-out.",
          "type": "string",
          "const": "xtls-rprx-vision-udp443"
        }
      ]
    },
    "Group": {
      "type": "object",
      "properties": {
        "filters": {
          "description": "The candidate set: multiple filters are OR-ed; each filter is a conjunction.\n\nA group carries no selection rule and no probe. It is a resource pool; an\n`[[election]]` names it as input and owns the rule that picks one member.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "HttpMethod": {
      "description": "Every HTTP method a health-check probe may use.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "HEAD"
          ]
        },
        {
          "description": "The two a probe can issue: it reads no body and discards the response, so anything\nelse would need a body or cannot be framed by this client. Advertising a method that\nsilently becomes `HEAD` is the \"accepted and ignored\" failure ADR-0006 removed.",
          "type": "string",
          "const": "GET"
        }
      ]
    },
    "Hysteria2Bandwidth": {
      "description": "Hysteria 2's bandwidth hints, in megabits per second.\n\n`brutal` pins its send window to `up-mbps`; the loss-based controllers ignore both.",
      "type": "object",
      "properties": {
        "down-mbps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "up-mbps": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Hysteria2Congestion": {
      "description": "Hysteria 2's congestion controller (ADR-0029).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "cubic",
            "new-reno"
          ]
        },
        {
          "description": "netune's BBR model window.",
          "type": "string",
          "const": "bbr"
        },
        {
          "description": "The reference's throughput-pinning controller; needs `up-mbps`/`down-mbps`.",
          "type": "string",
          "const": "brutal"
        }
      ]
    },
    "Hysteria2Obfs": {
      "description": "Hysteria 2's obfuscation layer (ADR-0029).\n\nTagged by `type` so a password is required by construction: `type = \"salamander\"`\nwithout a `password` does not deserialize, rather than connecting in the clear.",
      "oneOf": [
        {
          "description": "`[salt 8][payload]`, XORed with `BLAKE2b-256(psk ‖ salt)`.",
          "type": "object",
          "properties": {
            "Salamander": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "password"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Salamander"
          ]
        },
        {
          "description": "Salamander plus fragmentation of QUIC long-header packets.",
          "type": "object",
          "properties": {
            "Gecko": {
              "type": "object",
              "properties": {
                "max_packet_size": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                },
                "min_packet_size": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "password"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Gecko"
          ]
        }
      ]
    },
    "Hysteria2Quic": {
      "description": "Hysteria 2's QUIC tuning (ADR-0029).\n\nEvery field maps onto a `netune_quic::QuicProfile`/`QuicTransportParameters` knob, so a\nvalue here either changes the connection or is not in the model. The defaults are netune's\n(30 s idle timeout, 10 MB connection window); they are daer's own, not the reference's,\nbecause a daer deployment shares one daemon across many nodes and a buffer sized for one\nnode's 500 Mbit link would be wrong everywhere else.",
      "type": "object",
      "properties": {
        "congestion": {
          "description": "Congestion controller. `brutal` needs `[node.bandwidth]`.",
          "$ref": "#/$defs/Hysteria2Congestion",
          "default": "bbr"
        },
        "disable-path-mtu-discovery": {
          "description": "Disable netune's DPLPMTUD probing and keep datagrams at the QUIC\n1200-byte floor, matching the reference's `disablePathMTUDiscovery`.",
          "type": "boolean"
        },
        "disable-segmentation-offload": {
          "description": "Skip GSO. The owned QUIC engine performs no segmentation offload, so\nthis key is already satisfied; it is accepted for reference\ncompatibility and read by the connector rather than silently dropped.",
          "type": "boolean"
        },
        "init-conn-receive-window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "init-stream-receive-window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "keep-alive-period": {
          "description": "Keep-alive period. Zero keeps daer's 10 s default.",
          "type": "string",
          "default": "0s"
        },
        "max-conn-receive-window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max-idle-timeout": {
          "description": "Connection idle timeout. Zero keeps netune's default.",
          "type": "string",
          "default": "0s"
        },
        "max-stream-receive-window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Hysteria2Tls": {
      "description": "TLS parameters for Hysteria 2's intrinsic TLS leg.\n\nHysteria 2 adds a certificate digest pin on top of the ordinary TLS settings.",
      "type": "object",
      "properties": {
        "allow-insecure": {
          "description": "Accept any certificate. A deliberate, node-local assertion.",
          "type": "boolean"
        },
        "pin-sha256": {
          "description": "SHA-256 of the server's leaf certificate, hex. Compared after the chain check as a\nsecond factor, not a replacement for it.",
          "type": [
            "string",
            "null"
          ]
        },
        "sni": {
          "description": "SNI to present. Absent means the node's own hostname.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "IpVersionPrefer": {
      "description": "Preferred IP family for DNS answers (`\"any\"`, `\"ipv4\"`, or `\"ipv6\"`).",
      "type": "string",
      "enum": [
        "any",
        "ipv4",
        "ipv6"
      ]
    },
    "Node": {
      "description": "One `[[node]]` entry.",
      "type": "object",
      "properties": {
        "detour": {
          "description": "The node whose outbound carries this node's connection to its own server.\n\nThis is the detour seam (ADR-0044): the outer node's proxy protocol still names the\n*final* target, while the byte stream to its server is opened by another node. A chain\nis therefore `outer(detour=inner)`, not a new protocol.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "socks5"
            },
            "username": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "server",
            "port"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "http"
            },
            "username": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "server",
            "port"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "shadowsocks"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "method",
            "password"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "tls": {
              "$ref": "#/$defs/NodeTls"
            },
            "type": {
              "type": "string",
              "const": "trojan"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "password"
          ]
        },
        {
          "type": "object",
          "properties": {
            "idle-sessions": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "tls": {
              "$ref": "#/$defs/NodeTls"
            },
            "type": {
              "type": "string",
              "const": "anytls"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "password"
          ]
        },
        {
          "type": "object",
          "properties": {
            "bandwidth": {
              "$ref": "#/$defs/Hysteria2Bandwidth"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "obfs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Hysteria2Obfs"
                },
                {
                  "type": "null"
                }
              ]
            },
            "password": {
              "type": "string"
            },
            "port-hopping": {
              "$ref": "#/$defs/PortHopping"
            },
            "ports": {
              "description": "One port, a list, or a range (ADR-0029), e.g. `\"443,20000-20010\"`.",
              "type": "string"
            },
            "quic": {
              "$ref": "#/$defs/Hysteria2Quic"
            },
            "server": {
              "type": "string"
            },
            "tls": {
              "$ref": "#/$defs/Hysteria2Tls"
            },
            "type": {
              "type": "string",
              "const": "hysteria2"
            }
          },
          "required": [
            "type",
            "server",
            "ports",
            "password"
          ]
        },
        {
          "description": "VLESS: a UUID-authenticated session with an optional Vision flow.",
          "type": "object",
          "properties": {
            "flow": {
              "$ref": "#/$defs/Flow"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "security": {
              "$ref": "#/$defs/SecurityConfig"
            },
            "server": {
              "type": "string"
            },
            "transport": {
              "$ref": "#/$defs/TransportConfig"
            },
            "type": {
              "type": "string",
              "const": "vless"
            },
            "uuid": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "uuid"
          ]
        },
        {
          "description": "VMess AEAD (ADR-0030). The legacy handshake is not expressible.",
          "type": "object",
          "properties": {
            "authenticated-length": {
              "description": "Authenticate each chunk's length, not only its body. A wire change the server\nmust also have enabled, so it is explicit rather than defaulted (ADR-0030).",
              "type": "boolean"
            },
            "cipher": {
              "$ref": "#/$defs/VmessCipher"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "no-termination-signal": {
              "description": "Omit the terminating signal on shutdown.",
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "security": {
              "$ref": "#/$defs/SecurityConfig"
            },
            "server": {
              "type": "string"
            },
            "transport": {
              "$ref": "#/$defs/TransportConfig"
            },
            "type": {
              "type": "string",
              "const": "vmess"
            },
            "uuid": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "uuid"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "NodeTls": {
      "description": "TLS parameters of a protocol whose TLS leg is intrinsic.\n\nTrojan and AnyTLS always speak TLS to the node, so these keys live in `[node.tls]`\nrather than `[node.security]` (which selects an optional security layer for\nVLESS/VMess). There is no `type` key: there is nothing to select.",
      "type": "object",
      "properties": {
        "allow-insecure": {
          "description": "Accept any certificate. A deliberate, node-local assertion.",
          "type": "boolean"
        },
        "sni": {
          "description": "SNI to present. Absent means the node's own hostname.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "OutboundAction": {
      "description": "A routing action: the egress a rule sends a matching flow to.\n\n`\"direct\"` and `\"block\"` are reserved built-in policies; any other non-empty\nstring names a declared `[[election]]`.",
      "type": "string"
    },
    "PortHopping": {
      "description": "Hysteria 2's source-port hopping schedule.\n\nHopping changes the client's five-tuple without re-dialling the QUIC connection. The\nreference refuses a schedule shorter than 5 seconds, so the validator does too.",
      "type": "object",
      "properties": {
        "interval": {
          "description": "Fixed interval between hops. Zero means hopping is disabled.",
          "type": "string",
          "default": "0s"
        },
        "max-interval": {
          "description": "Upper bound of a randomised interval.",
          "type": "string",
          "default": "0s"
        },
        "min-interval": {
          "description": "Lower bound of a randomised interval, when it differs from `interval`.",
          "type": "string",
          "default": "0s"
        }
      },
      "additionalProperties": false
    },
    "ProbeMode": {
      "description": "What a probe measures.",
      "oneOf": [
        {
          "description": "A cheap liveness probe against the node's own server address. It proves the\nserver is reachable, not that the node can carry a request to the internet.",
          "type": "string",
          "const": "server"
        },
        {
          "description": "A request through the node to `url`. This is the Clash `url-test` shape: it\nproves the proxy session authenticated and the node can reach the target.",
          "type": "string",
          "const": "url"
        }
      ]
    },
    "ProviderFormat": {
      "type": "string",
      "enum": [
        "drb",
        "text"
      ]
    },
    "ProviderType": {
      "type": "string",
      "enum": [
        "file",
        "http"
      ]
    },
    "Routing": {
      "type": "object",
      "properties": {
        "default": {
          "description": "Default egress when no rule matches.",
          "$ref": "#/$defs/OutboundAction",
          "default": "direct"
        },
        "rule": {
          "description": "Ordered rules; the first matching rule wins.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoutingRule"
          }
        },
        "sniff": {
          "description": "What routing may do when DNS/Fake-IP cannot name the flow.",
          "$ref": "#/$defs/SniffConfig"
        }
      },
      "additionalProperties": false
    },
    "RoutingRule": {
      "description": "One ordered routing rule.",
      "type": "object",
      "properties": {
        "action": {
          "description": "The egress this rule selects.",
          "$ref": "#/$defs/OutboundAction"
        },
        "match": {
          "description": "Predicate conjunction. The action is a separate field, never part of it.",
          "type": "string"
        },
        "name": {
          "description": "Stable identity for diagnostics, logs and tests. Must be unique.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "match",
        "action"
      ]
    },
    "RuleProvider": {
      "description": "One `[[rule-set]]` entry. Internally this is still the rule provider spec:\nthe routing layer resolves it into a provider pool. The TOML key is\n`rule-set`; `rule-provider` remains accepted as a compatibility alias.",
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/ProviderFormat",
          "default": "drb"
        },
        "interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/ProviderType",
          "default": "file"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "SecurityConfig": {
      "description": "How a node's byte stream is made opaque.\n\nThis is the *security* layer: it owns a handshake, a certificate policy and an\nALPN offer, and it knows nothing about the protocol above it.",
      "oneOf": [
        {
          "description": "The protocol speaks over the transport directly.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Ordinary TLS to the node, verified against the platform trust store.",
          "type": "object",
          "properties": {
            "allow-insecure": {
              "description": "Accept any certificate. A node that needs this is a node whose chain cannot\nbe verified, which is a fact the operator should be asserting deliberately.",
              "type": "boolean"
            },
            "alpn": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fingerprint": {
              "description": "netune TLS preset name for this node's ClientHello. Absent uses\n`tls.profile`.",
              "type": [
                "string",
                "null"
              ]
            },
            "sni": {
              "description": "SNI to present. Absent means the node's own hostname.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "tls"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "REALITY: a tag in `legacy_session_id` authenticates the flow, and the\npresented certificate belongs to an impersonated site rather than to the node.",
          "type": "object",
          "properties": {
            "alpn": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "public-key": {
              "description": "The node's X25519 public key, base64url.",
              "type": "string"
            },
            "short-id": {
              "description": "Short id, up to 8 bytes, hex.",
              "type": [
                "string",
                "null"
              ]
            },
            "sni": {
              "description": "The impersonated site. Required, and never an address: SNI names a host.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "reality"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "sni",
            "public-key"
          ]
        }
      ]
    },
    "SniffConfig": {
      "description": "Payload-based domain recovery for routing.\n\nThis table deliberately configures only the fallback mechanism, not DNS. DNS is a\nservice and lives in [`crate::model::Dns`]; `sniff` is what routing may do when that\nservice (or Fake-IP) cannot provide a unique name.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether routing may inspect the first bytes of a flow for a domain.\n\n`None` is only valid when the configuration has no `domain(...)` rule. When a\ndomain rule exists the operator must choose: `true` allows a bounded payload\ninspection, `false` routes by the facts already known.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "timeout": {
          "description": "The total TCP wait budget. Only valid with `enabled = true`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Subscription": {
      "description": "`subscription = [\"url\"]` or `[[subscription]] name/url/persist`.",
      "anyOf": [
        {
          "description": "A bare URL, no name.",
          "type": "string"
        },
        {
          "description": "A named subscription.",
          "type": "object",
          "properties": {
            "detour": {
              "description": "Detour applied to every node this subscription contributes.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "Name used by `sub()` / `subtag()` filters.",
              "type": [
                "string",
                "null"
              ]
            },
            "persist": {
              "description": "Cache the last successful fetch next to the configuration.",
              "type": "boolean",
              "default": false
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        }
      ]
    },
    "Tls": {
      "description": "TLS identity and fragmentation.\n\n`profile` names a TLS fingerprint preset owned by netune; an unknown name\nfails at load time rather than silently falling back to the default identity,\nbecause a silently different ClientHello defeats the point of the option.",
      "type": "object",
      "properties": {
        "fragment": {
          "description": "Split the ClientHello across TCP segments.",
          "type": "boolean",
          "default": false
        },
        "fragment-interval": {
          "description": "Millisecond range for the delay between fragments, e.g. `10-20`.",
          "type": "string",
          "default": "10-20"
        },
        "fragment-length": {
          "description": "Byte range for `fragment`, e.g. `50-100`.",
          "type": "string",
          "default": "50-100"
        },
        "profile": {
          "description": "TLS fingerprint preset name, e.g. `chrome`. `None` uses netune's default.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "TransportConfig": {
      "description": "What wraps the stream below the protocol (ADR-0028).",
      "oneOf": [
        {
          "description": "A raw TCP session.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tcp"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "RFC 6455 over TCP, with the reference's `path`/`Host` framing.",
          "type": "object",
          "properties": {
            "headers": {
              "description": "Extra request headers, sent verbatim.",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "host": {
              "description": "`Host` header. Absent uses the node's SNI, then its hostname.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "Request path, e.g. `/ray`.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "ws"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ]
        }
      ]
    },
    "VmessCipher": {
      "description": "VMess's body cipher (ADR-0030).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "aes-128-gcm",
            "chacha20-poly1305"
          ]
        },
        {
          "description": "AES-GCM when the CPU has AES-NI, ChaCha20-Poly1305 otherwise — the\nreference's `SecurityType_AUTO`.",
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "WanInterface": {
      "description": "`wan-interface = \"auto\"` or `[\"eth0\", \"wg0\"]`.\n\nThe model derives this shape by hand so it can reject `[\"auto\"]` with an error that\nnames the replacement. The schema still has to say \"one keyword or a list\".",
      "anyOf": [
        {
          "description": "Follow the interface carrying the default route.",
          "$ref": "#/$defs/AutoKeyword"
        },
        {
          "description": "One or more explicitly named interfaces.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    }
  }
}
