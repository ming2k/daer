{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "dns": {
      "$ref": "#/$defs/Dns",
      "default": {
        "fake-ip": {
          "enabled": false,
          "exclude": [],
          "inet": "198.18.0.0/15",
          "pool-size": 65535
        },
        "ipversion-prefer": 0,
        "max-cache-size": 65536,
        "optimistic-cache": true,
        "optimistic-cache-ttl": 60,
        "optimistic-stale-reply-ttl": 30,
        "request": {
          "rules": []
        },
        "response": {
          "rules": []
        },
        "upstream": []
      }
    },
    "election": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Election"
      }
    },
    "global": {
      "$ref": "#/$defs/Global",
      "default": {
        "allow-insecure": false,
        "auto-sniff-punt": true,
        "disable-waiting-network": false,
        "lan-interface": [],
        "log-level": "info",
        "probe": {
          "interval": "30s",
          "method": "HEAD",
          "mode": "server",
          "timeout": "5s",
          "tolerance": "0s",
          "udp-dns": [
            "1.1.1.1:53",
            "8.8.8.8:53",
            "2001:4860:4860::8888:53"
          ],
          "url": null
        },
        "sniffing-timeout": "30ms",
        "tls": {
          "fragment": false,
          "fragment-interval": "10-20",
          "fragment-length": "50-100"
        },
        "wan-interface": [
          "auto"
        ]
      }
    },
    "group": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Group"
      }
    },
    "include": {
      "description": "Globs, relative to the directory of the file that names them.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "node": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "routing": {
      "$ref": "#/$defs/Routing",
      "default": {
        "fallback": "direct",
        "rules": []
      }
    },
    "rule-provider": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleProvider"
      }
    },
    "schema": {
      "description": "Schema version. Bumped when a change cannot be expressed as a default.",
      "type": "integer",
      "format": "uint32",
      "default": 2,
      "minimum": 0
    },
    "subscription": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Subscription"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Dns": {
      "type": "object",
      "properties": {
        "bind": {
          "type": [
            "string",
            "null"
          ]
        },
        "fake-ip": {
          "$ref": "#/$defs/FakeIpConfig",
          "default": {
            "enabled": false,
            "exclude": [],
            "inet": "198.18.0.0/15",
            "pool-size": 65535
          }
        },
        "fixed-domain-ttl": {
          "description": "`[dns.fixed-domain-ttl]` — domain to TTL in seconds.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int64"
          }
        },
        "ipversion-prefer": {
          "description": "`4`, `6`, or `0` for no preference.",
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "max-cache-size": {
          "type": "integer",
          "format": "int32",
          "default": 65536
        },
        "optimistic-cache": {
          "type": "boolean",
          "default": true
        },
        "optimistic-cache-ttl": {
          "type": "integer",
          "format": "int32",
          "default": 60
        },
        "optimistic-stale-reply-ttl": {
          "type": "integer",
          "format": "int32",
          "default": 30
        },
        "request": {
          "$ref": "#/$defs/DnsRouting",
          "default": {
            "rules": []
          }
        },
        "response": {
          "$ref": "#/$defs/DnsRouting",
          "default": {
            "rules": []
          }
        },
        "upstream": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DnsRouting": {
      "description": "`[dns.request]` / `[dns.response]`.",
      "type": "object",
      "properties": {
        "fallback": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Election": {
      "description": "One `[[election]]` entry: the routing target and the rule that elects one node.\n\nThe input is exactly one of `group` or `node`. A group is a set of candidates; a\nnode is a singleton candidate set. The output is always one node (or no node when\nthe input has no usable candidate).",
      "type": "object",
      "properties": {
        "group": {
          "description": "The candidate set. Mutually exclusive with `node`.",
          "type": [
            "string",
            "null"
          ]
        },
        "interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "description": "Probe overrides. `None` inherits `[global.probe]`.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProbeMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "node": {
          "description": "A singleton candidate set. Mutually exclusive with `group`.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "type": [
            "string",
            "null"
          ]
        },
        "tolerance": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "The selection rule.",
          "$ref": "#/$defs/ElectionKind"
        },
        "udp-dns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "ElectionKind": {
      "description": "How an election selects one node from its input.",
      "oneOf": [
        {
          "description": "The input must be a node; the election returns that node or fails when it is\nnot usable.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "Pick a random alive node.",
          "type": "string",
          "const": "random"
        },
        {
          "description": "Pick the node with the lowest last measured latency.",
          "type": "string",
          "const": "min"
        },
        {
          "description": "Pick the node with the lowest average of its last 10 latencies.",
          "type": "string",
          "const": "min-avg10"
        },
        {
          "description": "Pick the node with the lowest exponentially weighted moving average.",
          "type": "string",
          "const": "min-moving-avg"
        }
      ]
    },
    "FakeIpConfig": {
      "description": "`[dns.fake-ip]` — synthetic IP pool configuration (ADR-0012).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "exclude": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "inet": {
          "type": "string",
          "default": "198.18.0.0/15"
        },
        "inet6": {
          "description": "The optional IPv6 pool.\n\n`None` keeps the historic IPv4-only Fake-IP behaviour: `A` is synthesised and `AAAA`\nis answered with an empty NOERROR so a dual-stack client falls back to the synthetic\naddress. Setting a prefix enables IPv6 synthesis as well. The key is explicit rather\nthan a second meaning for `inet`, because one prefix cannot describe both families.",
          "type": [
            "string",
            "null"
          ]
        },
        "pool-size": {
          "type": "integer",
          "format": "uint",
          "default": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Filter": {
      "description": "A `group.filters` entry: an expression, or an expression plus values the\nselected node inherits.",
      "anyOf": [
        {
          "description": "`sub(sub) && !name(keyword: 'ExpireAt:')`",
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "annotate": {
              "description": "Values copied into the selected node's properties.",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "match": {
              "description": "The predicate conjunction.",
              "type": "string"
            }
          },
          "required": [
            "match"
          ]
        }
      ]
    },
    "Flow": {
      "description": "How a protocol's payload is framed (ADR-0028).\n\nVision is a VLESS flow, not a REALITY feature: the reference applies it from\n`flow`, and a node whose user is configured for it **rejects** a client that omits\nit, so this is not a tuning knob.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "xtls-rprx-vision"
          ]
        },
        {
          "description": "Vision with UDP/443 allowed through the tunnel. The reference refuses UDP/443\nunder plain Vision because a QUIC flow inside XTLS double-encrypts; this is the\nopt-out.",
          "type": "string",
          "const": "xtls-rprx-vision-udp443"
        }
      ]
    },
    "Global": {
      "type": "object",
      "properties": {
        "allow-insecure": {
          "type": "boolean",
          "default": false
        },
        "auto-sniff-punt": {
          "type": "boolean",
          "default": true
        },
        "disable-waiting-network": {
          "type": "boolean",
          "default": false
        },
        "lan-interface": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "log-level": {
          "description": "`tracing` filter directive, e.g. `info`, `debug`, or `daer=debug,netune=trace`.",
          "type": "string",
          "default": "info"
        },
        "probe": {
          "$ref": "#/$defs/ProbeSettings",
          "default": {
            "interval": "30s",
            "method": "HEAD",
            "mode": "server",
            "timeout": "5s",
            "tolerance": "0s",
            "udp-dns": [
              "1.1.1.1:53",
              "8.8.8.8:53",
              "2001:4860:4860::8888:53"
            ],
            "url": null
          }
        },
        "sniffing-timeout": {
          "type": "string",
          "default": "30ms"
        },
        "so-mark": {
          "description": "Socket mark for daer-originated traffic.\n\nOmitted, a privileged run picks [`daer_common::consts::DEFAULT_SOCKET_MARK`] and an\nunprivileged one marks nothing; the datapath and the redirect rule have to agree with\nwhichever it is, so the daemon decides once and reports the value it used.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tls": {
          "$ref": "#/$defs/Tls",
          "default": {
            "fragment": false,
            "fragment-interval": "10-20",
            "fragment-length": "50-100"
          }
        },
        "wan-interface": {
          "type": "array",
          "default": [
            "auto"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Group": {
      "type": "object",
      "properties": {
        "filters": {
          "description": "The candidate set: multiple filters are OR-ed; each filter is a conjunction.\n\nA group carries no selection rule and no probe. It is a resource pool; an\n`[[election]]` names it as input and owns the rule that picks one member.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "HttpMethod": {
      "description": "Every HTTP method a health-check probe may use.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "HEAD"
          ]
        },
        {
          "description": "The two a probe can issue: it reads no body and discards the response, so anything\nelse would need a body or cannot be framed by this client. Advertising a method that\nsilently becomes `HEAD` is the \"accepted and ignored\" failure ADR-0006 removed.",
          "type": "string",
          "const": "GET"
        }
      ]
    },
    "Hysteria2Congestion": {
      "description": "Hysteria 2's congestion controller (ADR-0029).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "cubic",
            "new-reno"
          ]
        },
        {
          "description": "netune's BBR model window.",
          "type": "string",
          "const": "bbr"
        },
        {
          "description": "The reference's throughput-pinning controller; needs `up-mbps`/`down-mbps`.",
          "type": "string",
          "const": "brutal"
        }
      ]
    },
    "Hysteria2Obfs": {
      "description": "Hysteria 2's obfuscation layer (ADR-0029).\n\nTagged by `type` so a password is required by construction: `type = \"salamander\"`\nwithout a `password` does not deserialize, rather than connecting in the clear.",
      "oneOf": [
        {
          "description": "`[salt 8][payload]`, XORed with `BLAKE2b-256(psk ‖ salt)`.",
          "type": "object",
          "properties": {
            "Salamander": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "password"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Salamander"
          ]
        },
        {
          "description": "Salamander plus fragmentation of QUIC long-header packets.",
          "type": "object",
          "properties": {
            "Gecko": {
              "type": "object",
              "properties": {
                "max_packet_size": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                },
                "min_packet_size": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "password"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Gecko"
          ]
        }
      ]
    },
    "Hysteria2Quic": {
      "description": "Hysteria 2's QUIC tuning (ADR-0029).\n\nEvery field maps onto a `netune_quic::QuicProfile`/`QuicTransportParameters` knob, so a\nvalue here either changes the connection or is not in the model. The defaults are netune's\n(30 s idle timeout, 10 MB connection window); they are daer's own, not the reference's,\nbecause a daer deployment shares one daemon across many nodes and a buffer sized for one\nnode's 500 Mbit link would be wrong everywhere else.",
      "type": "object",
      "properties": {
        "disable-path-mtu-discovery": {
          "description": "Disable netune's DPLPMTUD probing and keep datagrams at the QUIC\n1200-byte floor, matching the reference's `disablePathMTUDiscovery`.",
          "type": "boolean"
        },
        "disable-segmentation-offload": {
          "description": "Skip GSO. The owned QUIC engine performs no segmentation offload, so\nthis key is already satisfied; it is accepted for reference\ncompatibility and read by the connector rather than silently dropped.",
          "type": "boolean"
        },
        "init-conn-receive-window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "init-stream-receive-window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "keep-alive-period-ms": {
          "description": "Keep-alive period in milliseconds. `0` keeps daer's 10 s default.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max-conn-receive-window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max-idle-timeout-ms": {
          "description": "Connection idle timeout in milliseconds. `0` keeps netune's default.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max-stream-receive-window": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Node": {
      "description": "One `[[node]]` entry.",
      "type": "object",
      "properties": {
        "detour": {
          "description": "The node whose outbound carries this node's connection to its own server.\n\nThis is the detour seam (ADR-0044): the outer node's proxy protocol still names the\n*final* target, while the byte stream to its server is opened by another node. A chain\nis therefore `outer(detour=inner)`, not a new protocol.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "direct"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "socks5"
            },
            "username": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "server",
            "port"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "http"
            },
            "username": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "server",
            "port"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "shadowsocks"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "method",
            "password"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allow-insecure": {
              "type": "boolean"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "sni": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "trojan"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "password"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allow-insecure": {
              "type": "boolean"
            },
            "idle-sessions": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "password": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "server": {
              "type": "string"
            },
            "sni": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "any-tls"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "password"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allow-insecure": {
              "type": "boolean"
            },
            "congestion": {
              "$ref": "#/$defs/Hysteria2Congestion"
            },
            "down-mbps": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "obfs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Hysteria2Obfs"
                },
                {
                  "type": "null"
                }
              ]
            },
            "password": {
              "type": "string"
            },
            "pin-sha256": {
              "description": "Certificate digest pin: the SHA-256 of the server's leaf certificate, hex.\nCompared after the handshake, so it is a second factor rather than a\nreplacement for the chain.",
              "type": [
                "string",
                "null"
              ]
            },
            "ports": {
              "description": "One port, a list, or a range (ADR-0029).",
              "$ref": "#/$defs/PortSet"
            },
            "quic": {
              "$ref": "#/$defs/Hysteria2Quic"
            },
            "server": {
              "type": "string"
            },
            "sni": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "hysteria2"
            },
            "up-mbps": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "server",
            "ports",
            "password"
          ]
        },
        {
          "description": "VLESS: a UUID-authenticated session with an optional Vision flow.",
          "type": "object",
          "properties": {
            "flow": {
              "$ref": "#/$defs/Flow"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "security": {
              "$ref": "#/$defs/SecurityConfig"
            },
            "server": {
              "type": "string"
            },
            "transport": {
              "$ref": "#/$defs/TransportConfig"
            },
            "type": {
              "type": "string",
              "const": "vless"
            },
            "uuid": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "uuid"
          ]
        },
        {
          "description": "VMess AEAD (ADR-0030). The legacy handshake is not expressible.",
          "type": "object",
          "properties": {
            "authenticated-length": {
              "description": "Authenticate each chunk's length, not only its body. A wire change the server\nmust also have enabled, so it is explicit rather than defaulted (ADR-0030).",
              "type": "boolean"
            },
            "cipher": {
              "$ref": "#/$defs/VmessCipher"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "no-termination-signal": {
              "description": "Omit the terminating signal on shutdown.",
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "security": {
              "$ref": "#/$defs/SecurityConfig"
            },
            "server": {
              "type": "string"
            },
            "transport": {
              "$ref": "#/$defs/TransportConfig"
            },
            "type": {
              "type": "string",
              "const": "vmess"
            },
            "uuid": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "server",
            "port",
            "uuid"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "PortSet": {
      "description": "Ports a Hysteria 2 node may be reached on, and the hop schedule (ADR-0029).\n\nA reference `hysteria2://` link names either one port or a set\n(`443`, `443,8443`, `20000-30000`, `all`). The set is kept normalised — sorted,\nmerged, no overlaps — because the hop layer samples uniformly from it and a\nduplicated range would bias the rotation.",
      "type": "object",
      "properties": {
        "hop-max-ms": {
          "description": "Upper bound of the randomised interval.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "hop-min-ms": {
          "description": "Lower bound of the randomised interval, when it differs from `hop_ms`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "hop-ms": {
          "description": "Rotate the source port on this interval. `0` disables hopping.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ranges": {
          "description": "`low-high` ranges, inclusive, sorted and non-overlapping.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0
              },
              {
                "type": "integer",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "ranges"
      ]
    },
    "ProbeMode": {
      "description": "What a probe measures.",
      "oneOf": [
        {
          "description": "A cheap liveness probe against the node's own server address. It proves the\nserver is reachable, not that the node can carry a request to the internet.",
          "type": "string",
          "const": "server"
        },
        {
          "description": "A request through the node to `url`. This is the Clash `url-test` shape: it\nproves the proxy session authenticated and the node can reach the target.",
          "type": "string",
          "const": "url"
        }
      ]
    },
    "ProbeSettings": {
      "description": "Probe defaults, shared by `[global.probe]` and every election that overrides them.\n\nMeasurement is not a property of a group: a group is only a candidate set. An\nelection owns the probe it needs; the global table supplies defaults so a file\ndoes not repeat the same URL for every election.",
      "type": "object",
      "properties": {
        "interval": {
          "type": "string",
          "default": "30s"
        },
        "method": {
          "$ref": "#/$defs/HttpMethod",
          "default": "HEAD"
        },
        "mode": {
          "$ref": "#/$defs/ProbeMode",
          "default": "server"
        },
        "timeout": {
          "type": "string",
          "default": "5s"
        },
        "tolerance": {
          "description": "Shifts the switch threshold of moving averages.",
          "type": "string",
          "default": "0s"
        },
        "udp-dns": {
          "description": "DNS endpoints used by the server-liveness probe for datagram-carrying nodes.",
          "type": "array",
          "default": [
            "1.1.1.1:53",
            "8.8.8.8:53",
            "2001:4860:4860::8888:53"
          ],
          "items": {
            "type": "string"
          }
        },
        "url": {
          "description": "The URL requested when `mode = \"url\"`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ProviderFormat": {
      "type": "string",
      "enum": [
        "drb",
        "text"
      ]
    },
    "ProviderType": {
      "type": "string",
      "enum": [
        "file",
        "http"
      ]
    },
    "Routing": {
      "type": "object",
      "properties": {
        "fallback": {
          "type": "string",
          "default": "direct"
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "RuleProvider": {
      "description": "One `[[rule-provider]]` entry.",
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/ProviderFormat",
          "default": "drb"
        },
        "interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/ProviderType",
          "default": "file"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "SecurityConfig": {
      "description": "How a node's byte stream is made opaque.\n\nThis is the *security* layer: it owns a handshake, a certificate policy and an\nALPN offer, and it knows nothing about the protocol above it.",
      "oneOf": [
        {
          "description": "The protocol speaks over the transport directly.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Ordinary TLS to the node, verified against the platform trust store.",
          "type": "object",
          "properties": {
            "allow-insecure": {
              "description": "Accept any certificate. A node that needs this is a node whose chain cannot\nbe verified, which is a fact the operator should be asserting deliberately.",
              "type": "boolean"
            },
            "alpn": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fingerprint": {
              "description": "netune TLS preset name for this node's ClientHello. Absent uses\n`global.tls.profile`.",
              "type": [
                "string",
                "null"
              ]
            },
            "sni": {
              "description": "SNI to present. Absent means the node's own hostname.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "tls"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "REALITY: a tag in `legacy_session_id` authenticates the flow, and the\npresented certificate belongs to an impersonated site rather than to the node.",
          "type": "object",
          "properties": {
            "alpn": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "public-key": {
              "description": "The node's X25519 public key, base64url.",
              "type": "string"
            },
            "short-id": {
              "description": "Short id, up to 8 bytes, hex.",
              "type": [
                "string",
                "null"
              ]
            },
            "sni": {
              "description": "The impersonated site. Required, and never an address: SNI names a host.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "reality"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "sni",
            "public-key"
          ]
        }
      ]
    },
    "Subscription": {
      "description": "`subscription = [\"url\"]` or `[[subscription]] name/url/persist`.",
      "anyOf": [
        {
          "description": "A bare URL, no name.",
          "type": "string"
        },
        {
          "description": "A named subscription.",
          "type": "object",
          "properties": {
            "detour": {
              "description": "Detour applied to every node this subscription contributes.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "Name used by `sub()` / `subtag()` filters.",
              "type": [
                "string",
                "null"
              ]
            },
            "persist": {
              "description": "Cache the last successful fetch next to the configuration.",
              "type": "boolean",
              "default": false
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        }
      ]
    },
    "Tls": {
      "description": "TLS identity and fragmentation.\n\n`profile` names a TLS fingerprint preset owned by netune; an unknown name\nfails at load time rather than silently falling back to the default identity,\nbecause a silently different ClientHello defeats the point of the option.",
      "type": "object",
      "properties": {
        "fragment": {
          "description": "Split the ClientHello across TCP segments.",
          "type": "boolean",
          "default": false
        },
        "fragment-interval": {
          "description": "Millisecond range for the delay between fragments, e.g. `10-20`.",
          "type": "string",
          "default": "10-20"
        },
        "fragment-length": {
          "description": "Byte range for `fragment`, e.g. `50-100`.",
          "type": "string",
          "default": "50-100"
        },
        "profile": {
          "description": "TLS fingerprint preset name, e.g. `chrome`. `None` uses netune's default.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "TransportConfig": {
      "description": "What wraps the stream below the protocol (ADR-0028).",
      "oneOf": [
        {
          "description": "A raw TCP session.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tcp"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "RFC 6455 over TCP, with the reference's `path`/`Host` framing.",
          "type": "object",
          "properties": {
            "headers": {
              "description": "Extra request headers, sent verbatim.",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "host": {
              "description": "`Host` header. Absent uses the node's SNI, then its hostname.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "Request path, e.g. `/ray`.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "ws"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ]
        }
      ]
    },
    "VmessCipher": {
      "description": "VMess's body cipher (ADR-0030).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "aes-128-gcm",
            "chacha20-poly1305"
          ]
        },
        {
          "description": "AES-GCM when the CPU has AES-NI, ChaCha20-Poly1305 otherwise — the\nreference's `SecurityType_AUTO`.",
          "type": "string",
          "const": "auto"
        }
      ]
    }
  }
}
